{
  "version": 1,
  "description": "Issuing authorities Dwarpal recognises, and what each tier is permitted to do. Adding an authority is a configuration change, never a code change.",
  "tiers": {
    "unverified": {
      "rank": 0,
      "description": "No acceptable credential was presented. May browse, search, quote and hold, but not check out above the configured ceiling.",
      "max_transaction_minor": 50000,
      "allow_restricted_categories": false,
      "allow_age_restricted": false,
      "requires_key_binding": false
    },
    "provisional": {
      "rank": 1,
      "description": "Credential from a self-asserted or sandbox authority. Trusted for low value only.",
      "max_transaction_minor": 250000,
      "allow_restricted_categories": false,
      "allow_age_restricted": false,
      "requires_key_binding": true
    },
    "accredited": {
      "rank": 2,
      "description": "Credential from an authority that attests it obtained user consent on a trusted surface.",
      "max_transaction_minor": 2000000,
      "allow_restricted_categories": true,
      "allow_age_restricted": false,
      "requires_key_binding": true
    },
    "regulated": {
      "rank": 3,
      "description": "Credential from a supervised financial institution or payment network.",
      "max_transaction_minor": 10000000,
      "allow_restricted_categories": true,
      "allow_age_restricted": true,
      "requires_key_binding": true
    }
  },
