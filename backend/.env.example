# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
MCP_PUBLIC_URL=

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dwarpal
DB_USER=dwarpal
DB_PASSWORD=

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_S2S_ENABLED=false

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SEMANTIC_TIMEOUT_SECONDS=12

# --- WhatsApp (Meta Cloud API) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
META_WABA_ID=
META_GRAPH_VERSION=v23.0
META_TEMPLATE_NAME=dwarpal_purchase_approval
META_TEMPLATE_LANGUAGE=en

# --- Escalation ---
ESCALATION_HUMAN_WHATSAPP=
ESCALATION_DEADLINE_SECONDS=900

# --- Purchase receipts over WhatsApp ---
NOTIFY_PURCHASE_RECEIPTS=true
META_RECEIPT_TEMPLATE_NAME=dwarpal_purchase_receipt
META_RECEIPT_TEMPLATE_LANGUAGE=en

# Shared secret the dashboard sends as X-Merchant-Token. Required; unset closes the surface.
MERCHANT_API_TOKEN=replace-with-a-long-random-value

# --- Merchant identity and signing ---
MERCHANT_ID=dwarpal-demo-merchant
MERCHANT_NAME=Dwarpal Demo Store
MERCHANT_WEBSITE=https://dwarpal.example
MERCHANT_KEY_ID=dwarpal-merchant
MERCHANT_SIGNING_KEY_DIR=./secrets/merchant_keys

# --- Configuration files ---
TRUST_REGISTRY_PATH=./config/trust_registry.json
CATALOG_SEED_PATH=./config/catalog_seed.json
POLICY_TERMS_PATH=./config/policy_terms.md

# --- Policy limits ---
CREDENTIAL_CLOCK_SKEW_SECONDS=60
PRESENCE_MAX_AGE_SECONDS=120
UNVERIFIED_CEILING_MINOR=50000
BUDGET_RESERVATION_TTL_SECONDS=300
INVENTORY_HOLD_TTL_SECONDS=600
INVENTORY_HOLD_QUOTA_PER_AGENT=5
VELOCITY_WINDOW_SECONDS=3600
STRUCTURING_WINDOW_SECONDS=900
